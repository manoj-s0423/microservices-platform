# === User Service Configuration ===
# These map to application.yml via Spring's relaxed env-var binding.

# Server
SERVER_PORT=8081
LOG_LEVEL=INFO
SHUTDOWN_TIMEOUT=10s

# Database (PostgreSQL - owned exclusively by user-service)
DB_HOST=
DB_PORT=5432
DB_NAME=shopstream_users
DB_USER=
DB_PASSWORD=
DB_CONNECTION_TIMEOUT_MS=5000
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=2

# Security
JWT_SECRET=
JWT_EXPIRATION_MS=3600000
