# === Product Service Configuration ===

# Server
PORT=8000
LOG_LEVEL=info
ENVIRONMENT=development

# Database (PostgreSQL - owned exclusively by product-service)
DB_HOST=
DB_PORT=5432
DB_NAME=shopstream_products
DB_USER=
DB_PASSWORD=
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=10
DB_CONNECT_TIMEOUT_SECONDS=5

# Pagination defaults
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
