# === Payment Service Configuration ===
# ASP.NET Core reads these as flat configuration keys (IConfiguration),
# either from the process environment or a mounted appsettings file.

# Server
ASPNETCORE_URLS=http://+:8083
ASPNETCORE_ENVIRONMENT=Development
SHUTDOWN_TIMEOUT_SECONDS=10

# Database (PostgreSQL - owned exclusively by payment-service)
DB_HOST=
DB_PORT=5432
DB_NAME=shopstream_payments
DB_USER=
DB_PASSWORD=
DB_CONNECT_TIMEOUT_SECONDS=5

# External payment gateway (the platform's one external, third-party dependency)
Gateway__Mode=simulated
Gateway__BaseUrl=
Gateway__TimeoutSeconds=5
Gateway__RetryAttempts=2
Gateway__DeclineThresholdCents=1000000
