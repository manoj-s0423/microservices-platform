# === Notification Service Configuration ===

# Server
PORT=8084
NODE_ENV=development
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000

# Database (MongoDB - owned exclusively by notification-service)
MONGO_URI=
MONGO_CONNECT_TIMEOUT_MS=5000

# External notification providers (email/SMS)
EMAIL_PROVIDER_MODE=simulated
EMAIL_PROVIDER_API_URL=
EMAIL_PROVIDER_API_KEY=
EMAIL_PROVIDER_TIMEOUT_MS=3000
EMAIL_PROVIDER_RETRY_ATTEMPTS=2

SMS_PROVIDER_MODE=simulated
SMS_PROVIDER_API_URL=
SMS_PROVIDER_API_KEY=
